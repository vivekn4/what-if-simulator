# ------------------------------------------------------------------
# What-If Life Simulator — environment configuration
# Copy to .env and adjust. NEVER commit a real .env with secrets.
# ------------------------------------------------------------------

# Port the server listens on (Render sets this automatically).
PORT=3000

# API key for the AI provider. REQUIRED — the server refuses /api/chat
# without it (clean JSON 500, no crash).
# Get a FREE key from Google AI Studio: https://aistudio.google.com/apikey
AI_API_KEY=

# OpenAI-compatible endpoint. Defaults to Google's free Gemini endpoint.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model to request. Any model available on the endpoint works.
AI_MODEL=gemini-3.8-flash

# Storytelling creativity (0.0 - 2.0). Higher = wilder alternate histories.
AI_TEMPERATURE=0.85

# Max tokens per AI reply. A 10-year timeline needs ~1500; branches ~400.
AI_MAX_TOKENS=2000

# Upstream timeout in milliseconds.
AI_TIMEOUT_MS=60000

# Comma-separated list of allowed frontend origins, e.g.
# FRONTEND_URL=https://what-if-simulator.onrender.com
# Leave empty to allow all origins (fine for local dev; the server logs a
# warning — set this before going live).
FRONTEND_URL=

# Per-IP rate limit for POST /api/chat: RATE_LIMIT_MAX requests per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120

# Trust proxy hops for correct client IPs behind Render/Heroku-style hosts.
TRUST_PROXY=1
